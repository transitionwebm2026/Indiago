# Copy this file to .env.local, fill in the values, then rebuild (`npm run build`).
# Every value here is public by design — it is inlined into the static site.

# --- Supabase CMS (dashboard at /admin/) -------------------------------------
# Supabase → Project Settings → API Keys. Use the publishable key (sb_publishable_…), never a
# secret or service_role key. Older projects can set NEXT_PUBLIC_SUPABASE_ANON_KEY to the legacy anon key instead.
# Leave both empty to run the website on its built-in content, with no dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Live updates: visitors' pages refresh the moment content is saved (Supabase Realtime).
# Set to false to refresh only when a visitor returns to the tab.
NEXT_PUBLIC_CMS_REALTIME=true

# --- Google Search Console (optional) ----------------------------------------
# Search Console → Add property → HTML tag: paste only the content="…" value. Adds the
# google-site-verification meta tag to every page on the next build.
GOOGLE_SITE_VERIFICATION=

# --- Web3Forms (optional) ----------------------------------------------------
# Enables "Send via Email" on the inquiry form and the blog newsletter.
# Create a free access key at https://web3forms.com (it is safe to expose publicly).
# Without a key, the forms fall back to WhatsApp and the visitor's email app (mailto:).
NEXT_PUBLIC_WEB3FORMS_KEY=
